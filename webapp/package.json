{
  "name": "community-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "deploy": "yarn build && firebase deploy",
    "deploy_hosting": "yarn build && firebase deploy --only hosting:communitymap",
    "index_sync": "firebase firestore:indexes > ../firestore.indexes.json"
  },
  "dependencies": {
    "@opencommunitymap/react-sdk": "^0.1.0-rc11",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "firebase": "^12.18.0",
    "query-string": "^9.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "@mui/material": "^9.4.0",
    "@mui/icons-material": "^9.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "devDependencies": {
    "@firebase-oss/ui-core": "^7.1.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-ci": "^0.15.1",
    "firebase-tools": "^15.29.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
