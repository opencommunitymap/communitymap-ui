{
  "name": "community-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "deploy": "yarn build && firebase deploy",
    "deploy_hosting": "yarn build && firebase deploy --only hosting:communitymap",
    "index_sync": "firebase firestore:indexes > ../firestore.indexes.json"
  },
  "dependencies": {
    "@opencommunitymap/react-sdk": "^0.1.0-rc10",
    "classnames": "^2.2.6",
    "dayjs": "^1.8.28",
    "firebase": "^7.15.0",
    "firebaseui": "^4.5.1",
    "query-string": "^6.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^5.3.4",
    "@mui/material": "^9.4.0",
    "@mui/icons-material": "^9.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "devDependencies": {
    "@types/classnames": "^2.2.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^14.0.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-ci": "^0.13.0",
    "firebase-tools": "^8.4.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
