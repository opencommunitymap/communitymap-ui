{
  "name": "community-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "deploy": "yarn build && firebase deploy",
    "deploy_hosting": "yarn build && firebase deploy --only hosting:communitymap",
    "index_sync": "firebase firestore:indexes > ../firestore.indexes.json"
  },
  "dependencies": {
    "@opencommunitymap/react-sdk": "^0.1.0-rc7",
    "classnames": "^2.2.6",
    "dayjs": "^1.8.28",
    "firebase": "^7.15.0",
    "firebaseui": "^4.5.1",
    "google-map-react": "^1.1.7",
    "query-string": "^6.12.1",
    "react": "^16.14.0",
    "react-cookie-consent": "^5.1.1",
    "react-dom": "^16.14.0",
    "react-router-dom": "^5.2.0",
    "semantic-ui-css": "^2.4.1",
    "semantic-ui-react": "^0.88.2"
  },
  "devDependencies": {
    "@types/classnames": "^2.2.10",
    "@types/google-map-react": "^1.1.8",
    "@types/node": "^14.0.11",
    "@types/react": "^16.9.35",
    "@types/react-dom": "^16.9.8",
    "@types/react-router-dom": "^5.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "firebase-ci": "^0.13.0",
    "firebase-tools": "^8.4.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
