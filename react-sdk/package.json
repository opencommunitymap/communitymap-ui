  "homepage": "https://github.com/opencommunitymap/communitymap-ui",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && yarn sync-css",
    "watch": "rm -rf dist && concurrently 'tsc -w' 'yarn sync-css -w'",
    "sync-css": "sync-glob -d false src/components/*.css dist/components/"
  },
  "peerDependencies": {
    "firebase": "^11.0.0 || ^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@firebase-oss/ui-core": "^7.1.0",
    "@firebase-oss/ui-react": "^7.1.0",
    "@firebase-oss/ui-styles": "^7.1.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "maplibre-gl": "^5.24.0",
    "react-map-gl": "^8.1.3",
    "@mui/material": "^9.4.0",
    "@mui/icons-material": "^9.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^10.0.5",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sync-glob": "^1.4.0",
    "typescript": "~7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
